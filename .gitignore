# --- Kernel module and test build output ---
# bsd.kmod.mk and bsd.progs.mk build in-tree, so everything below lands
# next to the sources rather than in a build directory.
*.o
*.ko
*.meta
*.full
*.debug
.depend*
export_syms

# Generated by the kmod build, not authored here.
machine
x86
i386
opt_global.h

# The test programs themselves (bsd.progs.mk drops them in tests/).
tests/ngp_test
tests/ngp_fuzz
tests/ngp_bench

# Process history: kept on disk, not part of the module's source.
.superpowers/

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/
